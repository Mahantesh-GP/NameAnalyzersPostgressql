# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phonetic_native

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# Database Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_CONNECTION_LIFETIME=300

# Application Settings
APP_NAME=Phonetic Search UI
APP_VERSION=1.0.0
DEBUG=true
API_BASE_URL=http://localhost:5116

# CORS Settings (JSON array format)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
