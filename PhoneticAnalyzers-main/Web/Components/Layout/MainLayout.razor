@inherits LayoutComponentBase

<div class="app-container">
    <!-- Modern Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/mortgage-search">
                <i class="bi bi-building me-2"></i>
                Mortgage Name Search
            </a>
            
            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/mortgage-search">
                    <i class="bi bi-search"></i> Search
                </a>
                <a class="nav-link text-white" href="/load-sample-data">
                    <i class="bi bi-database-add"></i> Load Sample Data
                </a>
                <StatusIndicator />
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="container-fluid py-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
