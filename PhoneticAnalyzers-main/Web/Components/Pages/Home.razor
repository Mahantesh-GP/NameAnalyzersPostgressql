@page "/"
@using PhoneticAnalyzers.Web.Services
@inject PhoneticAnalyzersApiService ApiService
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard - PhoneticAnalyzers</PageTitle>

<div class="fade-in">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">Dashboard</h1>
            <p class="text-muted mb-0">Phonetic Name Matching System Overview</p>
        </div>
        <div>
            <button class="btn btn-primary" @onclick="RefreshData">
                <i class="bi bi-arrow-clockwise me-2"></i>Refresh
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card stat-card success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="stat-number text-success">@TotalSearches.ToString("N0")</div>
                            <div class="stat-label">Total Searches</div>
                        </div>
                        <div class="text-success">
                            <i class="bi bi-search fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card stat-card warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="stat-number text-warning">@TotalPersons.ToString("N0")</div>
                            <div class="stat-label">Persons in Database</div>
                        </div>
                        <div class="text-warning">
                            <i class="bi bi-people fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="stat-number text-primary">@MatchAccuracy.ToString("P1")</div>
                            <div class="stat-label">Match Accuracy</div>
                        </div>
                        <div class="text-primary">
                            <i class="bi bi-bullseye fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card stat-card danger h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="stat-number text-danger">@AvgResponseTime.ToString("F1")ms</div>
                            <div class="stat-label">Avg Response Time</div>
                        </div>
                        <div class="text-danger">
                            <i class="bi bi-speedometer fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions and Recent Activity -->
    <div class="row">
        <!-- Quick Actions -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-lightning-fill me-2"></i>Quick Actions
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <a href="/search" class="btn btn-outline-primary w-100 p-3">
                                <i class="bi bi-search fs-4 d-block mb-2"></i>
                                <div class="fw-bold">Search Persons</div>
                                <small class="text-muted">Find similar names using phonetic matching</small>
                            </a>
                        </div>
                        <div class="col-12">
                            <a href="/person-management" class="btn btn-outline-success w-100 p-3">
                                <i class="bi bi-person-plus fs-4 d-block mb-2"></i>
                                <div class="fw-bold">Add Person</div>
                                <small class="text-muted">Add a new person to the database</small>
                            </a>
                        </div>
                        <div class="col-12">
                            <a href="/batch-operations" class="btn btn-outline-info w-100 p-3">
                                <i class="bi bi-upload fs-4 d-block mb-2"></i>
                                <div class="fw-bold">Batch Upload</div>
                                <small class="text-muted">Import multiple persons at once</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Search Results -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history me-2"></i>Recent Search Results</span>
                    <small class="text-light">Live Demo</small>
                </div>
                <div class="card-body">
                    @if (IsLoadingDemo)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="mt-2">Loading demo data...</div>
                        </div>
                    }
                    else if (DemoSearchResults.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var result in DemoSearchResults.Take(5))
                            {
                                <div class="list-group-item border-0 px-0 search-result-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1 fw-bold">@result.FullName</h6>
                                            <p class="mb-1 text-muted small">ID: @result.ExternalId</p>
                                            <small class="text-muted">Match: @result.MatchType</small>
                                        </div>
                                        <span class="similarity-badge @GetSimilarityClass(result.SimilarityScore)">
                                            @result.SimilarityScore.ToString("P0")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mt-3 text-center">
                            <a href="/search" class="btn btn-sm btn-outline-primary">View All Results</a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-search fs-1 d-block mb-3 opacity-50"></i>
                            <p>No recent searches</p>
                            <a href="/search" class="btn btn-primary">Start Searching</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- System Status -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-gear-fill me-2"></i>System Status
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="d-flex align-items-center">
                                @if (ApiHealthy)
                                {
                                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                    <div>
                                        <div class="fw-bold">API Service</div>
                                        <small class="text-success">Online and responding</small>
                                    </div>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger me-2 fs-5"></i>
                                    <div>
                                        <div class="fw-bold">API Service</div>
                                        <small class="text-danger">Offline or not responding</small>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-database-check text-info me-2 fs-5"></i>
                                <div>
                                    <div class="fw-bold">Database</div>
                                    <small class="text-info">PostgreSQL Connected</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-lightning-fill text-warning me-2 fs-5"></i>
                                <div>
                                    <div class="fw-bold">Performance</div>
                                    <small class="text-warning">Optimal response times</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int TotalSearches = 1247;
    private int TotalPersons = 8923;
    private double MatchAccuracy = 0.942;
    private double AvgResponseTime = 45.3;
    
    private bool ApiHealthy = false;
    private bool IsLoadingDemo = true;
    private List<PersonSearchResult> DemoSearchResults = new();

    protected override async Task OnInitializedAsync()
    {
        await CheckApiHealth();
        await LoadDemoData();
    }

    private async Task CheckApiHealth()
    {
        try
        {
            var health = await ApiService.HealthCheckAsync();
            ApiHealthy = health != null && health.Status == "Healthy";
        }
        catch
        {
            ApiHealthy = false;
        }
    }

    private async Task LoadDemoData()
    {
        IsLoadingDemo = true;
        StateHasChanged();

        try
        {
            // Simulate loading time for demo
            await Task.Delay(1500);
            
            // Try to get real search results, fallback to demo data
            try
            {
                var searchResult = await ApiService.SearchPersonsAsync("John", 5);
                if (searchResult != null && searchResult.Results.Any())
                {
                    DemoSearchResults = searchResult.Results;
                }
                else
                {
                    // Fallback demo data
                    CreateDemoData();
                }
            }
            catch
            {
                CreateDemoData();
            }
        }
        finally
        {
            IsLoadingDemo = false;
            StateHasChanged();
        }
    }

    private void CreateDemoData()
    {
        DemoSearchResults = new List<PersonSearchResult>
        {
            new() { 
                FullName = "John Smith", 
                ExternalId = "EMP001", 
                SimilarityScore = 0.95, 
                MatchType = "DoubleMetaphone" 
            },
            new() { 
                FullName = "Jane Doe", 
                ExternalId = "EMP002", 
                SimilarityScore = 0.87, 
                MatchType = "BeiderMorse" 
            },
            new() { 
                FullName = "Robert Johnson", 
                ExternalId = "EMP003", 
                SimilarityScore = 0.92, 
                MatchType = "DoubleMetaphone" 
            },
            new() { 
                FullName = "Maria Garcia", 
                ExternalId = "EMP004", 
                SimilarityScore = 0.78, 
                MatchType = "Trigram" 
            },
            new() { 
                FullName = "David Wilson", 
                ExternalId = "EMP005", 
                SimilarityScore = 0.83, 
                MatchType = "BeiderMorse" 
            }
        };
    }

    private string GetSimilarityClass(double similarity)
    {
        return similarity switch
        {
            >= 0.9 => "similarity-high",
            >= 0.7 => "similarity-medium",
            _ => "similarity-low"
        };
    }

    private async Task RefreshData()
    {
        await CheckApiHealth();
        await LoadDemoData();
        
        // Simulate data refresh
        TotalSearches += Random.Shared.Next(1, 5);
        AvgResponseTime = Random.Shared.NextDouble() * 20 + 35;
        
        StateHasChanged();
    }
}
