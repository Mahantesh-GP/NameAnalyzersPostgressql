@page "/person-management"
@rendermode InteractiveServer
@using PhoneticAnalyzers.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using PhoneticAnalyzers.Web.Components.Shared
@inject PhoneticAnalyzersApiService ApiService

<PageTitle>Person Management - PhoneticAnalyzers</PageTitle>

<div class="fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">Person Management</h1>
            <p class="text-muted mb-0">Add and manage persons in the phonetic database</p>
        </div>
    </div>

    <!-- Add Person Form -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-person-plus me-2"></i>Add New Person
        </div>
        <div class="card-body">
            <EditForm Model="PersonModel" OnValidSubmit="HandleAddPerson" Enhance="false">
                <DataAnnotationsValidator />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">External ID</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-tag"></i>
                            </span>
                            <InputText @bind-Value="PersonModel.ExternalId" 
                                     class="form-control" 
                                     placeholder="e.g., EMP001, USER123" />
                        </div>
                        <ValidationMessage For="() => PersonModel.ExternalId" class="text-danger small" />
                        <small class="form-text text-muted">Unique identifier for this person in your system</small>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <InputText @bind-Value="PersonModel.FullName" 
                                     class="form-control" 
                                     placeholder="e.g., John Smith" />
                        </div>
                        <ValidationMessage For="() => PersonModel.FullName" class="text-danger small" />
                        <small class="form-text text-muted">Complete name as it should be stored</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <div class="form-check">
                            <InputCheckbox @bind-Value="PersonModel.ExpandNicknames" class="form-check-input" id="expandNicknames" />
                            <label class="form-check-label fw-bold" for="expandNicknames">
                                Expand Nicknames
                            </label>
                            <div class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Enable to generate phonetic codes for common nicknames (e.g., "Bob" for "Robert")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@IsAdding">
                        @if (IsAdding)
                        {
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span>Adding Person...</span>
                        }
                        else
                        {
                            <i class="bi bi-plus-circle me-2"></i>
                            <span>Add Person</span>
                        }
                    </button>
                    
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Reset Form
                    </button>
                    
                    <button type="button" class="btn btn-outline-info" @onclick="TestClick">
                        <i class="bi bi-bug me-2"></i>Test Connection
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- API Validation Errors -->
    @if (ValidationErrors != null && ValidationErrors.Any())
    {
        <PhoneticAnalyzers.Web.Components.Shared.ValidationSummary 
            Title="Validation Failed" 
            Detail="Please correct the following errors before submitting:"
            Errors="ValidationErrors" />
    }

    <!-- Success Message -->
    @if (LastAddedPerson != null)
    {
        <div class="alert alert-success d-flex align-items-center slide-in">
            <i class="bi bi-check-circle me-2"></i>
            <div class="flex-grow-1">
                <strong>Person Added Successfully!</strong>
                <div class="mt-2">
                    <strong>Name:</strong> @LastSubmittedPersonData?.FullName<br>
                    <strong>ID:</strong> @LastSubmittedPersonData?.ExternalId<br>
                    <strong>Person ID:</strong> @LastAddedPerson.PersonId<br>
                    <strong>Status:</strong> @(LastAddedPerson.WasCreated ? "Created" : "Updated")
                </div>
                
                @if (LastAddedPerson.PhoneticCodes != null)
                {
                    <div class="mt-3">
                        <strong>Generated Phonetic Codes:</strong>
                        <div class="phonetic-codes mt-2">
                            @if (!string.IsNullOrEmpty(LastAddedPerson.PhoneticCodes.Primary))
                            {
                                <span class="phonetic-code">Primary: @LastAddedPerson.PhoneticCodes.Primary</span>
                            }
                            @if (!string.IsNullOrEmpty(LastAddedPerson.PhoneticCodes.Alternate))
                            {
                                <span class="phonetic-code">Alternate: @LastAddedPerson.PhoneticCodes.Alternate</span>
                            }
                            @foreach (var bmCode in LastAddedPerson.PhoneticCodes.BeiderMorseCodes.Take(3))
                            {
                                <span class="phonetic-code">BM: @bmCode</span>
                            }
                        </div>
                    </div>
                }

                @if (LastAddedPerson.Warnings.Any())
                {
                    <div class="mt-3">
                        <strong>Warnings:</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var warning in LastAddedPerson.Warnings)
                            {
                                <li class="small text-warning">@warning</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <button type="button" class="btn-close" @onclick="ClearSuccessMessage"></button>
        </div>
    }

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center slide-in">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div class="flex-grow-1">
                <strong>Error Adding Person:</strong> @ErrorMessage
            </div>
            <button type="button" class="btn-close" @onclick='() => ErrorMessage = ""'></button>
        </div>
    }

    <!-- Quick Test Section -->
    <div class="card">
        <div class="card-header">
            <i class="bi bi-lightning-fill me-2"></i>Quick Test
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                Test the phonetic matching by adding some sample persons and then searching for variations of their names.
            </p>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h6 class="fw-bold text-primary">Sample Names to Add:</h6>
                    <div class="list-group">
                        @foreach (var sample in SampleNames)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@sample.Name</div>
                                    <small class="text-muted">ID: @sample.Id</small>
                                </div>
                                <button class="btn btn-sm btn-outline-primary" 
                                        @onclick="() => AddSamplePerson(sample)"
                                        disabled="@IsAdding">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="col-md-6 mb-3">
                    <h6 class="fw-bold text-primary">Then Try Searching:</h6>
                    <div class="list-group">
                        @foreach (var searchTerm in SampleSearches)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">"@searchTerm"</div>
                                    <small class="text-muted">Should find similar names</small>
                                </div>
                                <a href="/search" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-search"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PersonRequest PersonModel = new();
    private PersonIngestResult? LastAddedPerson;
    private PersonData? LastSubmittedPersonData;
    private bool IsAdding = false;
    private string ErrorMessage = "";
    private List<PhoneticAnalyzersApiService.ValidationErrorItem>? ValidationErrors;

    private readonly List<(string Name, string Id)> SampleNames = new()
    {
        ("John Smith", "EMP001"),
        ("Catherine Johnson", "EMP002"),
        ("Robert Brown", "EMP003"),
        ("Maria Garcia", "EMP004"),
        ("David Wilson", "EMP005")
    };

    private readonly List<string> SampleSearches = new()
    {
        "Jon Smyth",
        "Katherine Jonson",
        "Bob Brown",
        "Marie Garcia",
        "Dave Wilson"
    };

    public class PersonRequest
    {
        [Required(ErrorMessage = "External ID is required")]
        [StringLength(64, ErrorMessage = "External ID cannot exceed 64 characters")]
        public string ExternalId { get; set; } = "";

        [Required(ErrorMessage = "Full name is required")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Full name must be between 2 and 200 characters")]
        public string FullName { get; set; } = "";

        public bool ExpandNicknames { get; set; } = true;
    }

    private async Task HandleAddPerson()
    {
        Console.WriteLine($"[DEBUG] HandleAddPerson called. ExternalId: '{PersonModel.ExternalId}', FullName: '{PersonModel.FullName}'");
        
        IsAdding = true;
        ErrorMessage = "";
        ValidationErrors = null;
        LastAddedPerson = null;
        StateHasChanged();

        try
        {
            var personData = new PersonData
            {
                ExternalId = PersonModel.ExternalId.Trim(),
                FullName = PersonModel.FullName.Trim(),
                ExpandNicknames = PersonModel.ExpandNicknames
            };

            Console.WriteLine($"[DEBUG] Calling API with ExternalId: '{personData.ExternalId}', FullName: '{personData.FullName}'");
            
            LastAddedPerson = await ApiService.AddPersonAsync(personData);
            LastSubmittedPersonData = personData;
            
            Console.WriteLine($"[DEBUG] Person added successfully. PersonId: {LastAddedPerson?.PersonId}");
            
            // Reset form after successful add
            ResetForm();
        }
        catch (PhoneticAnalyzersApiService.ValidationApiException vex)
        {
            Console.WriteLine($"[DEBUG] Validation error: {vex.Message}");
            // Structured validation errors from API
            ValidationErrors = vex.Problem?.Errors?.ToList();
            ErrorMessage = vex.Problem?.Detail ?? "Validation failed";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DEBUG] Error: {ex.Message}");
            Console.WriteLine($"[DEBUG] Stack: {ex.StackTrace}");
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsAdding = false;
            StateHasChanged();
        }
    }

    private async Task AddSamplePerson((string Name, string Id) sample)
    {
        PersonModel.ExternalId = sample.Id;
        PersonModel.FullName = sample.Name;
        PersonModel.ExpandNicknames = true;
        
        await HandleAddPerson();
    }

    private void ResetForm()
    {
        PersonModel = new PersonRequest { ExpandNicknames = true };
        ErrorMessage = "";
        ValidationErrors = null;
    }

    private void ClearSuccessMessage()
    {
        LastAddedPerson = null;
        LastSubmittedPersonData = null;
    }
    
    private void TestClick()
    {
        Console.WriteLine("[DEBUG] Test button clicked - Blazor is working!");
        ErrorMessage = $"Test clicked at {DateTime.Now:HH:mm:ss} - Blazor connection is working!";
        StateHasChanged();
    }
}