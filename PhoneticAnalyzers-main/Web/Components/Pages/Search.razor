@page "/search"
@rendermode InteractiveServer
@using PhoneticAnalyzers.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject PhoneticAnalyzersApiService ApiService

<PageTitle>Search - PhoneticAnalyzers</PageTitle>

<div class="fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">Phonetic Search</h1>
            <p class="text-muted mb-0">Find similar names using advanced phonetic matching algorithms</p>
        </div>
    </div>

    <!-- Search Form -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-search me-2"></i>Search Parameters
        </div>
        <div class="card-body">
            <EditForm Model="SearchModel" OnValidSubmit="HandleSearch"  Enhance="false" FormName="SearchForm">
                <DataAnnotationsValidator />
                
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label fw-bold">Name to Search</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <InputText @bind-Value="SearchModel.Name" 
                                       class="form-control" 
                                       placeholder="Enter full name (e.g., John Smith)"
                                       @onkeypress="HandleKeyPress" />
                        </div>
                        <ValidationMessage For="() => SearchModel.Name" class="text-danger small" />
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Max Results</label>
                        <InputSelect TValue="int" @bind-Value="SearchModel.MaxResults" class="form-select">
                            <option value="5">5 results</option>
                            <option value="10">10 results</option>
                            <option value="25">25 results</option>
                            <option value="50">50 results</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@IsSearching">
                        @if (IsSearching)
                        {
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-2"></i>
                            <span>Search Names</span>
                        }
                    </button>
                    
                    @if (SearchResults != null)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearResults">
                            <i class="bi bi-x-circle me-2"></i>Clear Results
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Search Results -->
    @if (SearchResults != null)
    {
        <div class="card slide-in">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-list-ul me-2"></i>Search Results
                </span>
                <div class="d-flex align-items-center gap-3">
                    <small class="text-light">
                        <i class="bi bi-clock me-1"></i>@SearchResults.ExecutionTime.ToString("F1")ms
                    </small>
                    <span class="badge bg-primary">@SearchResults.TotalResults results</span>
                </div>
            </div>
            <div class="card-body">
                @if (SearchResults.Results.Any())
                {
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="alert alert-info d-flex align-items-center">
                                <i class="bi bi-info-circle me-2"></i>
                                <div>
                                    <strong>Search Query:</strong> "@SearchResults.Query" | 
                                    <strong>Found:</strong> @SearchResults.TotalResults matches |
                                    <strong>Algorithm:</strong> Multiple phonetic matching algorithms
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>External ID</th>
                                    <th>Similarity</th>
                                    <th>Match Type</th>
                                    <th>Phonetic Codes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in SearchResults.Results)
                                {
                                    <tr class="search-result-item">
                                        <td>
                                            <div class="fw-bold">@result.FullName</div>
                                            @if (!string.IsNullOrEmpty(result.NormalizedName) && result.NormalizedName != result.FullName)
                                            {
                                                <small class="text-muted">Normalized: @result.NormalizedName</small>
                                            }
                                        </td>
                                        <td>
                                            <code class="bg-light px-2 py-1 rounded">@result.ExternalId</code>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 8px;">
                                                    <div class="progress-bar @GetProgressBarClass(result.SimilarityScore)" 
                                                         style="width: @(result.SimilarityScore * 100)%"></div>
                                                </div>
                                                <span class="similarity-badge @GetSimilarityClass(result.SimilarityScore)">
                                                    @result.SimilarityScore.ToString("P0")
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@result.MatchType</span>
                                        </td>
                                        <td>
                                            @if (result.PhoneticCodes != null)
                                            {
                                                <div class="phonetic-codes">
                                                    @if (!string.IsNullOrEmpty(result.PhoneticCodes.DoubleMetaphone.Primary))
                                                    {
                                                        <span class="phonetic-code">DM: @result.PhoneticCodes.DoubleMetaphone.Primary</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(result.PhoneticCodes.DoubleMetaphone.Alternate))
                                                    {
                                                        <span class="phonetic-code">ALT: @result.PhoneticCodes.DoubleMetaphone.Alternate</span>
                                                    }
                                                    @foreach (var bmCode in result.PhoneticCodes.BeiderMorse.Take(2))
                                                    {
                                                        <span class="phonetic-code">BM: @bmCode</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not available</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search fs-1 text-muted opacity-50 d-block mb-3"></i>
                        <h5 class="text-muted">No matches found</h5>
                        <p class="text-muted">
                            Try searching with a different name or check the spelling.
                            <br>The system uses phonetic matching, so exact spelling isn't required.
                        </p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Search Tips -->
    @if (SearchResults == null && !IsSearching)
    {
        <div class="card">
            <div class="card-header">
                <i class="bi bi-lightbulb me-2"></i>Search Tips
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary">How Phonetic Search Works</h6>
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Double Metaphone:</strong> Finds names that sound similar when spoken
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Beider-Morse:</strong> Advanced algorithm for multilingual names
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                <strong>Fuzzy Matching:</strong> Tolerates spelling variations and typos
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-primary">Search Examples</h6>
                        <div class="list-group list-group-flush">
                            <div class="list-group-item border-0 px-0">
                                <button class="btn btn-outline-primary btn-sm" @onclick='() => SearchExample("John Smith")'>
                                    Search "John Smith"
                                </button>
                                <small class="text-muted d-block">Finds: Jon Smyth, John Smythe, etc.</small>
                            </div>
                            <div class="list-group-item border-0 px-0">
                                <button class="btn btn-outline-primary btn-sm" @onclick='() => SearchExample("Catherine Johnson")'>
                                    Search "Catherine Johnson"
                                </button>
                                <small class="text-muted d-block">Finds: Katherine Jonson, Kathryn Johnsen, etc.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Error Display -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center slide-in">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div>
                <strong>Search Error:</strong> @ErrorMessage
            </div>
            <button type="button" class="btn-close ms-auto" @onclick='() => ErrorMessage = ""'></button>
        </div>
    }
</div>

@code {
    private SearchRequest SearchModel = new();
    private SearchResult? SearchResults;
    private bool IsSearching = false;
    private string ErrorMessage = "";

    public class SearchRequest
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 200 characters")]
        public string Name { get; set; } = "";
        
        public int MaxResults { get; set; } = 10;
    }

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchModel.Name)) return;

        IsSearching = true;
        ErrorMessage = "";
        StateHasChanged();

        try
        {
            SearchResults = await ApiService.SearchPersonsAsync(SearchModel.Name.Trim(), SearchModel.MaxResults);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to search: {ex.Message}";
            SearchResults = null;
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private void HandleInvalidSubmit()
    {
        ErrorMessage = "Please enter a valid name (2-200 characters)";
        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsSearching && !string.IsNullOrWhiteSpace(SearchModel.Name))
        {
            await HandleSearch();
        }
    }

    private void ClearResults()
    {
        SearchResults = null;
        ErrorMessage = "";
    }

    private async Task SearchExample(string name)
    {
        SearchModel.Name = name;
        await HandleSearch();
    }

    private string GetSimilarityClass(double similarity)
    {
        return similarity switch
        {
            >= 0.9 => "similarity-high",
            >= 0.7 => "similarity-medium",
            _ => "similarity-low"
        };
    }

    private string GetProgressBarClass(double similarity)
    {
        return similarity switch
        {
            >= 0.9 => "bg-success",
            >= 0.7 => "bg-warning",
            _ => "bg-danger"
        };
    }
}}