@page "/load-sample-data"
@using PhoneticAnalyzers.Application.Commands.Ingestion
@using MediatR
@inject IMediator Mediator
@inject ILogger<LoadSampleData> Logger

<h1>Load Sample Mortgage Data</h1>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-database"></i> Load Sample Mortgage Data</h3>
                    <p class="mb-0">Load the sample mortgage data from the CSV file into the database</p>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading sample data...</p>
                        </div>
                    }
                    else if (result != null)
                    {
                        <div class="alert @(result.RecordsFailed > 0 ? "alert-warning" : "alert-success")" role="alert">
                            <h5><i class="fas fa-check-circle"></i> Sample Data Loaded Successfully!</h5>
                            <div class="row">
                                <div class="col-md-3">
                                    <strong>Total Processed:</strong> @result.TotalRecordsProcessed
                                </div>
                                <div class="col-md-3">
                                    <strong>Inserted:</strong> @result.RecordsInserted
                                </div>
                                <div class="col-md-3">
                                    <strong>Updated:</strong> @result.RecordsUpdated
                                </div>
                                <div class="col-md-3">
                                    <strong>Failed:</strong> @result.RecordsFailed
                                </div>
                            </div>
                            @if (result.ProcessingDuration.TotalSeconds > 0)
                            {
                                <div class="mt-2">
                                    <strong>Processing Time:</strong> @result.ProcessingDuration.TotalSeconds.ToString("F2") seconds
                                    <span class="text-muted">(@result.RecordsPerSecond.ToString("F2") records/sec)</span>
                                </div>
                            }
                        </div>

                        @if (result.BatchErrors.Any())
                        {
                            <div class="alert alert-danger">
                                <h6>Batch Errors:</h6>
                                <ul>
                                    @foreach (var error in result.BatchErrors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (result.SampleFailedRecords.Any())
                        {
                            <div class="alert alert-warning">
                                <h6>Sample Failed Records:</h6>
                                @foreach (var failedRecord in result.SampleFailedRecords.Take(5))
                                {
                                    <div class="mb-1">
                                        <strong>@failedRecord.RecordId:</strong> @failedRecord.ErrorMessage
                                        @if (!string.IsNullOrEmpty(failedRecord.RawData))
                                        {
                                            <br><small class="text-muted">Data: @failedRecord.RawData</small>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-3">
                            <a href="/mortgage-search" class="btn btn-primary">
                                <i class="fas fa-search"></i> Go to Mortgage Search
                            </a>
                            <button class="btn btn-secondary ms-2" @onclick="ResetPage">
                                <i class="fas fa-refresh"></i> Load Again
                            </button>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5><i class="fas fa-exclamation-triangle"></i> Error Loading Data</h5>
                            <p>@errorMessage</p>
                            <button class="btn btn-outline-danger" @onclick="ResetPage">
                                <i class="fas fa-retry"></i> Try Again
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- File Upload Section -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h5><i class="fas fa-file-upload"></i> Upload CSV File</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label for="csvFile" class="form-label">Select CSV File</label>
                                            <InputFile id="csvFile" class="form-control" OnChange="HandleFileSelected" accept=".csv" />
                                            <div class="form-text">Upload your CSV file with mortgage data (sample_mortgage_extended.csv, etc.)</div>
                                        </div>
                                        
                                        @if (selectedFile != null)
                                        {
                                            <div class="alert alert-info">
                                                <strong>Selected File:</strong> @selectedFile.Name<br>
                                                <strong>Size:</strong> @FormatFileSize(selectedFile.Size)<br>
                                                <strong>Type:</strong> @selectedFile.ContentType
                                            </div>
                                        }

                                        <div class="mb-3">
                                            <label class="form-label">Batch Size</label>
                                            <select @bind="batchSize" class="form-select">
                                                <option value="50">50 records per batch</option>
                                                <option value="100" selected>100 records per batch</option>
                                                <option value="250">250 records per batch</option>
                                                <option value="500">500 records per batch</option>
                                                <option value="1000">1000 records per batch</option>
                                            </select>
                                        </div>

                                        <div class="form-check mb-3">
                                            <input @bind="skipPhoneticEncoding" class="form-check-input" type="checkbox" id="skipPhonetic">
                                            <label class="form-check-label" for="skipPhonetic">
                                                Skip phonetic encoding (faster import)
                                            </label>
                                        </div>

                                        <button class="btn btn-success" @onclick="UploadAndProcessFileAsync" disabled="@(selectedFile == null || isLoading)">
                                            <i class="fas fa-cloud-upload-alt"></i> Upload & Process File
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h5><i class="fas fa-database"></i> Load Sample Data</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <p><i class="fas fa-info-circle"></i> Load the default sample mortgage data from <code>sample_mortgage_data.csv</code></p>
                                            <p class="text-muted">Contains 10 sample records with individuals, businesses, and unknown entities across Florida counties.</p>
                                        </div>

                                        <div class="mb-3">
                                            <h6>Sample Data Preview:</h6>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-striped">
                                                    <thead>
                                                        <tr>
                                                            <th>External ID</th>
                                                            <th>Full Name</th>
                                                            <th>County</th>
                                                            <th>Type</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr><td>MTG001</td><td>John Smith</td><td>Miami-Dade</td><td>Individual</td></tr>
                                                        <tr><td>MTG002</td><td>Jane Johnson Corp</td><td>Miami-Dade</td><td>Business</td></tr>
                                                        <tr><td>MTG003</td><td>Robert Brown</td><td>Broward</td><td>Individual</td></tr>
                                                        <tr><td>MTG004</td><td>Sarah Davis LLC</td><td>Broward</td><td>Business</td></tr>
                                                        <tr><td>MTG005</td><td>Michael Wilson</td><td>Palm Beach</td><td>Individual</td></tr>
                                                        <tr class="text-muted"><td colspan="4">... and 5 more records</td></tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <button class="btn btn-primary" @onclick="LoadSampleDataAsync" disabled="@isLoading">
                                            <i class="fas fa-upload"></i> Load Default Sample
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isLoading = false;
    private BulkIngestResult? result;
    private string errorMessage = string.Empty;
    private IBrowserFile? selectedFile;
    private int batchSize = 100;
    private bool skipPhoneticEncoding = false;

    private async Task LoadSampleDataAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            result = null;

            // Get the path to the sample data file
            var sampleDataPath = Path.Combine(Directory.GetCurrentDirectory(), "..", "sample_mortgage_data.csv");
            
            // Normalize the path
            sampleDataPath = Path.GetFullPath(sampleDataPath);

            Logger.LogInformation("Loading sample data from: {FilePath}", sampleDataPath);

            if (!File.Exists(sampleDataPath))
            {
                errorMessage = $"Sample data file not found at: {sampleDataPath}";
                return;
            }

            var command = new BulkIngestCommand
            {
                DataSource = sampleDataPath,
                BatchSize = batchSize,
                SkipPhoneticEncoding = skipPhoneticEncoding,
                ContinueOnError = true,
                SourceSystem = "SampleData"
            };

            result = await Mediator.Send(command);
            Logger.LogInformation("Sample data loaded successfully. Processed: {Count}", result.TotalRecordsProcessed);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading sample data");
            errorMessage = $"Error loading sample data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        Logger.LogInformation("File selected: {FileName} ({Size} bytes)", selectedFile.Name, selectedFile.Size);
    }

    private async Task UploadAndProcessFileAsync()
    {
        if (selectedFile == null) return;

        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            result = null;

            // Create temporary file path
            var tempPath = Path.Combine(Path.GetTempPath(), $"upload_{Guid.NewGuid()}.csv");
            
            Logger.LogInformation("Uploading file: {FileName} to {TempPath}", selectedFile.Name, tempPath);

            // Save uploaded file to temporary location
            using (var fileStream = new FileStream(tempPath, FileMode.Create))
            {
                await selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024).CopyToAsync(fileStream); // 50MB max
            }

            var command = new BulkIngestCommand
            {
                DataSource = tempPath,
                BatchSize = batchSize,
                SkipPhoneticEncoding = skipPhoneticEncoding,
                ContinueOnError = true,
                SourceSystem = $"FileUpload:{selectedFile.Name}"
            };

            result = await Mediator.Send(command);
            Logger.LogInformation("File processed successfully. Processed: {Count}", result.TotalRecordsProcessed);

            // Clean up temp file
            try
            {
                File.Delete(tempPath);
            }
            catch (Exception cleanupEx)
            {
                Logger.LogWarning(cleanupEx, "Failed to delete temporary file: {TempPath}", tempPath);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing uploaded file");
            errorMessage = $"Error processing file: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetPage()
    {
        result = null;
        errorMessage = string.Empty;
        isLoading = false;
        selectedFile = null;
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int suffixIndex = 0;
        double size = bytes;

        while (size >= 1024 && suffixIndex < suffixes.Length - 1)
        {
            size /= 1024;
            suffixIndex++;
        }

        return $"{size:F1} {suffixes[suffixIndex]}";
    }
}