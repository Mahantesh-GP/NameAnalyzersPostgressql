@page "/"
@page "/mortgage-search"
@rendermode InteractiveServer
@using PhoneticAnalyzers.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject PhoneticAnalyzersApiService ApiService

<PageTitle>Mortgage Search - PhoneticAnalyzers</PageTitle>

<div class="fade-in">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">
                <i class="bi bi-building me-2 text-primary"></i>Mortgage Name Search
            </h1>
            <p class="text-muted mb-0">Advanced phonetic search with county and record type filtering for mortgage professionals</p>
        </div>
    </div>

    <!-- Search Form -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="bi bi-funnel me-2"></i>Advanced Search Filters
        </div>
        <div class="card-body">
            <EditForm Model="SearchModel" OnValidSubmit="HandleSearch" Enhance="false" FormName="MortgageSearchForm">
                <DataAnnotationsValidator />
                
                <!-- Name Search Row -->
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Name to Search</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-search"></i>
                            </span>
                            <InputText @bind-Value="SearchModel.Name" 
                                       class="form-control" 
                                       placeholder="Enter full name (e.g., John Smith, Smith Corp)"
                                       @onkeypress="HandleKeyPress" />
                        </div>
                        <ValidationMessage For="() => SearchModel.Name" class="text-danger small" />
                    </div>
                </div>

                <!-- Filter Row -->
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">County Filter</label>
                        <InputSelect TValue="int?" @bind-Value="SearchModel.CountyId" class="form-select">
                            <option value="">All Counties</option>
                            @if (AvailableCounties != null)
                            {
                                @foreach (var county in AvailableCounties)
                                {
                                    <option value="@county.CountyId">@county.CountyName</option>
                                }
                            }
                        </InputSelect>
                        <div class="form-text">Filter results by specific county</div>
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Record Type</label>
                        <InputSelect TValue="string" @bind-Value="SearchModel.RecordType" class="form-select">
                            <option value="">All Types</option>
                            <option value="I">Individual</option>
                            <option value="B">Business/Corporate</option>
                            <option value="U">Unknown</option>
                        </InputSelect>
                        <div class="form-text">Filter by individual or business entities</div>
                    </div>
                    
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Max Results</label>
                        <InputSelect TValue="int" @bind-Value="SearchModel.MaxResults" class="form-select">
                            <option value="5">5 results</option>
                            <option value="10">10 results</option>
                            <option value="25">25 results</option>
                            <option value="50">50 results</option>
                            <option value="100">100 results</option>
                        </InputSelect>
                        <div class="form-text">Limit number of results returned</div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSearching">
                        @if (IsSearching)
                        {
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-2"></i>
                            <span>Search Names</span>
                        }
                    </button>
                    
                    @if (SearchResults != null)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearResults">
                            <i class="bi bi-x-circle me-2"></i>Clear Results
                        </button>
                    }

                    <button type="button" class="btn btn-outline-info" @onclick="LoadSampleSearch">
                        <i class="bi bi-card-list me-2"></i>Load Sample
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Active Filters Display -->
    @if (HasActiveFilters())
    {
        <div class="alert alert-info d-flex align-items-center mb-4">
            <i class="bi bi-info-circle me-2"></i>
            <div class="flex-grow-1">
                <strong>Active Filters:</strong>
                @if (SearchModel.CountyId.HasValue && AvailableCounties != null)
                {
                    var selectedCounty = AvailableCounties.FirstOrDefault(c => c.CountyId == SearchModel.CountyId.Value);
                    if (selectedCounty != null)
                    {
                        <span class="badge bg-primary ms-2">@selectedCounty.CountyName</span>
                    }
                }
                @if (!string.IsNullOrEmpty(SearchModel.RecordType))
                {
                    var recordTypeLabel = SearchModel.RecordType switch {
                        "I" => "Individual",
                        "B" => "Business/Corporate", 
                        "U" => "Unknown",
                        _ => SearchModel.RecordType
                    };
                    <span class="badge bg-secondary ms-2">@recordTypeLabel</span>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearFilters">
                Clear Filters
            </button>
        </div>
    }

    <!-- Search Results -->
    @if (SearchResults != null)
    {
        <div class="card slide-in">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-list-ul me-2"></i>Mortgage Search Results
                </span>
                <div class="d-flex align-items-center gap-3">
                    <small class="text-light">
                        <i class="bi bi-clock me-1"></i>@SearchResults.ExecutionTime.ToString("F1")ms
                    </small>
                    <span class="badge bg-primary">@SearchResults.TotalResults results</span>
                </div>
            </div>
            <div class="card-body">
                @if (SearchResults.Results.Any())
                {
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="alert alert-success d-flex align-items-center">
                                <i class="bi bi-check-circle me-2"></i>
                                <div>
                                    <strong>Search Query:</strong> "@SearchResults.Query" | 
                                    <strong>Found:</strong> @SearchResults.TotalResults matches |
                                    <strong>Phonetic Algorithms:</strong> Double Metaphone + Beider-Morse
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>External ID</th>
                                    <th>County</th>
                                    <th>Type</th>
                                    <th>Similarity</th>
                                    <th>Match Type</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in SearchResults.Results)
                                {
                                    <tr class="search-result-item">
                                        <td>
                                            <div class="fw-bold">@result.FullName</div>
                                            @if (!string.IsNullOrEmpty(result.NormalizedName) && result.NormalizedName != result.FullName)
                                            {
                                                <small class="text-muted">Normalized: @result.NormalizedName</small>
                                            }
                                        </td>
                                        <td>
                                            <code class="bg-light px-2 py-1 rounded">@result.ExternalId</code>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="fw-bold">@result.CountyName</span>
                                                @if (!string.IsNullOrEmpty(result.County))
                                                {
                                                    <br><small class="text-muted">@result.County (ID: @result.CountyId)</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge @GetRecordTypeBadgeClass(result.Flag)">
                                                @GetRecordTypeLabel(result.Flag)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 8px;">
                                                    <div class="progress-bar @GetProgressBarClass(result.SimilarityScore)" 
                                                         style="width: @(result.SimilarityScore * 100)%"></div>
                                                </div>
                                                <span class="similarity-badge @GetSimilarityClass(result.SimilarityScore)">
                                                    @result.SimilarityScore.ToString("P0")
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@result.MatchType</span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button type="button" class="btn btn-outline-primary" 
                                                        @onclick="() => ShowDetails(result)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-success" 
                                                        @onclick="() => CopyToClipboard(result.ExternalId)">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search fs-1 text-muted opacity-50 d-block mb-3"></i>
                        <h5 class="text-muted">No matches found</h5>
                        <p class="text-muted">
                            Try adjusting your search criteria:
                            <br>• Remove county or record type filters
                            <br>• Check spelling or try phonetic variations
                            <br>• Use partial names or nicknames
                        </p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Mortgage Search Guide -->
    @if (SearchResults == null && !IsSearching)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-lightbulb me-2"></i>Mortgage Search Features
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-primary">Advanced Phonetic Matching</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle text-success me-2"></i>
                                        Finds similar sounding names across different spellings
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle text-success me-2"></i>
                                        Handles multilingual and ethnic name variations
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-check-circle text-success me-2"></i>
                                        Supports both individual and business entity names
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-primary">Mortgage-Specific Filters</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="bi bi-geo-alt text-warning me-2"></i>
                                        <strong>County Filter:</strong> Search within specific counties
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-person-badge text-info me-2"></i>
                                        <strong>Record Type:</strong> Individual vs Business entities
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-speedometer text-danger me-2"></i>
                                        <strong>Performance:</strong> Optimized for millions of records
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-card-checklist me-2"></i>Quick Examples
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary text-start" @onclick='() => SearchExample("John Smith", null, "I")'>
                                <strong>"John Smith"</strong><br>
                                <small class="text-muted">Individuals only</small>
                            </button>
                            <button class="btn btn-outline-primary text-start" @onclick='() => SearchExample("Smith Corporation", null, "B")'>
                                <strong>"Smith Corp"</strong><br>
                                <small class="text-muted">Businesses only</small>
                            </button>
                            <button class="btn btn-outline-primary text-start" @onclick='() => SearchExample("Garcia", 1, null)'>
                                <strong>"Garcia"</strong><br>
                                <small class="text-muted">Miami-Dade County</small>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Error Display -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center slide-in">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <div>
                <strong>Search Error:</strong> @ErrorMessage
            </div>
            <button type="button" class="btn-close ms-auto" @onclick='() => ErrorMessage = ""'></button>
        </div>
    }
</div>

@code {
    private MortgageSearchRequest SearchModel = new();
    private SearchResult? SearchResults;
    private List<CountyInfo>? AvailableCounties;
    private bool IsSearching = false;
    private string ErrorMessage = "";

    public class MortgageSearchRequest
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Name must be between 2 and 200 characters")]
        public string Name { get; set; } = "";
        
        public int? CountyId { get; set; }
        
        public string? RecordType { get; set; }
        
        public int MaxResults { get; set; } = 25;
    }

    protected override async Task OnInitializedAsync()
    {
        // Load available counties
        try
        {
            AvailableCounties = await ApiService.GetCountiesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load counties: {ex.Message}";
        }
    }

    private async Task HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchModel.Name)) return;

        IsSearching = true;
        ErrorMessage = "";
        StateHasChanged();

        try
        {
            SearchResults = await ApiService.SearchPersonsAsync(
                SearchModel.Name.Trim(), 
                SearchModel.MaxResults, 
                SearchModel.CountyId, 
                SearchModel.RecordType);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to search: {ex.Message}";
            SearchResults = null;
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsSearching && !string.IsNullOrWhiteSpace(SearchModel.Name))
        {
            await HandleSearch();
        }
    }

    private void ClearResults()
    {
        SearchResults = null;
        ErrorMessage = "";
    }

    private void ClearFilters()
    {
        SearchModel.CountyId = null;
        SearchModel.RecordType = null;
        StateHasChanged();
    }

    private async Task SearchExample(string name, int? countyId = null, string? recordType = null)
    {
        SearchModel.Name = name;
        SearchModel.CountyId = countyId;
        SearchModel.RecordType = recordType;
        await HandleSearch();
    }

    private async Task LoadSampleSearch()
    {
        SearchModel.Name = "John Smith";
        SearchModel.CountyId = 1; // Miami-Dade
        SearchModel.RecordType = "I"; // Individual
        await HandleSearch();
    }

    private bool HasActiveFilters()
    {
        return SearchModel.CountyId.HasValue || !string.IsNullOrEmpty(SearchModel.RecordType);
    }

    private string GetRecordTypeLabel(string flag)
    {
        return flag switch
        {
            "I" => "Individual",
            "B" => "Business",
            "U" => "Unknown",
            _ => flag ?? "Unknown"
        };
    }

    private string GetRecordTypeBadgeClass(string flag)
    {
        return flag switch
        {
            "I" => "bg-success",
            "B" => "bg-primary",
            "U" => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }

    private string GetSimilarityClass(double similarity)
    {
        return similarity switch
        {
            >= 0.9 => "similarity-high",
            >= 0.7 => "similarity-medium",
            _ => "similarity-low"
        };
    }

    private string GetProgressBarClass(double similarity)
    {
        return similarity switch
        {
            >= 0.9 => "bg-success",
            >= 0.7 => "bg-warning",
            _ => "bg-danger"
        };
    }

    private void ShowDetails(PersonSearchResult result)
    {
        // TODO: Implement modal or navigation to detail view
        ErrorMessage = $"Details for {result.FullName} (ID: {result.ExternalId})";
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await Task.Run(() => {
                // Simple implementation - in a real app you'd use JS interop
                ErrorMessage = $"Copied: {text}";
            });
        }
        catch
        {
            ErrorMessage = $"Failed to copy: {text}";
        }
    }
}