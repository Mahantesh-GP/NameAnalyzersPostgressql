@using MudBlazor
@using PhoneticAnalyzers.WebUI.Models
@using PhoneticAnalyzers.WebUI.Services
@inject ILogger<SearchForm> Logger
@inject ISearchApiClient SearchApi

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Search Criteria
    </MudText>

    <EditForm Model="@Model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <MudGrid>
            <!-- Name Input with Autocomplete -->
            <MudItem xs="12" md="6">
                <MudAutocomplete 
                    T="string"
                    @bind-Value="Model.QueryName"
                    @bind-Text="Model.QueryName"
                    Label="Name to Search" 
                    Variant="Variant.Outlined"
                    SearchFunc="@SearchNames"
                    DebounceInterval="300"
                    ResetValueOnEmptyText="false"
                    CoerceText="true"
                    CoerceValue="false"
                    Clearable="true"
                    HelperText="Type a name to see suggestions"
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Person"
                    MinCharacters="2"
                    MaxItems="10" />
            </MudItem>

            <!-- Max Results -->
            <MudItem xs="6" md="3">
                <MudNumericField 
                    @bind-Value="Model.MaxResults" 
                    Label="Max Results" 
                    Variant="Variant.Outlined"
                    Min="1"
                    Max="200"
                    Step="10"
                    HelperText="1-200 results" />
            </MudItem>

            <!-- Min Similarity -->
            <MudItem xs="6" md="3">
                <MudNumericField 
                    @bind-Value="Model.MinSimilarityThreshold" 
                    Label="Min Similarity (%)" 
                    Variant="Variant.Outlined"
                    Min="0"
                    Max="100"
                    Step="5"
                    Format="N0"
                    HelperText="0% - 100%" />
            </MudItem>

            <!-- County Filter -->
            <MudItem xs="12" md="4">
                <MudSelect 
                    @bind-Value="Model.CountyId" 
                    Label="County Filter" 
                    Variant="Variant.Outlined"
                    Clearable="true"
                    AdornmentIcon="@Icons.Material.Filled.LocationOn"
                    Adornment="Adornment.Start">
                    <MudSelectItem T="int?" Value="null">(All Counties)</MudSelectItem>
                    @if (Counties != null)
                    {
                        @foreach (var county in Counties)
                        {
                            <MudSelectItem T="int?" Value="@county.CountyId">
                                @county.CountyName (@county.County)
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>

            <!-- Record Type Filter -->
            <MudItem xs="12" md="4">
                <MudSelect 
                    @bind-Value="Model.RecordType" 
                    Label="Record Type" 
                    Variant="Variant.Outlined"
                    Clearable="true"
                    AdornmentIcon="@Icons.Material.Filled.Category"
                    Adornment="Adornment.Start">
                    <MudSelectItem T="string?" Value="null">(All Types)</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("I")">Individual</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("B")">Business</MudSelectItem>
                    <MudSelectItem T="string?" Value="@("U")">Unknown</MudSelectItem>
                </MudSelect>
            </MudItem>

            <!-- Options hidden by request: Fuzzy and Nicknames default ON in model -->

            <!-- Submit and Clear Buttons -->
            <MudItem xs="12" Class="d-flex justify-center gap-3">
                <MudButton 
                    ButtonType="ButtonType.Submit" 
                    Variant="Variant.Filled" 
                    Color="Color.Primary"
                    Size="Size.Medium"
                    Disabled="@IsLoading"
                    Style="box-shadow: 0 3px 12px 0 rgba(34,197,94,0.10), 0 1.5px 4px 0 rgba(59,130,246,0.10); border-radius: 10px; font-weight: 600; letter-spacing: 0.5px; background: linear-gradient(90deg, #22d3ee 0%, #3b82f6 100%); padding: 10px 32px;">
                    @if (IsLoading)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" Color="Color.Secondary" />
                        <MudText>Searching...</MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
                        <MudText>Search</MudText>
                    }
                </MudButton>
                <MudButton 
                    Variant="Variant.Outlined" 
                    Color="Color.Default"
                    Size="Size.Medium"
                    Disabled="@IsLoading"
                    OnClick="@ClearForm"
                    Style="border-radius: 10px; font-weight: 600; letter-spacing: 0.5px; padding: 10px 32px;">
                    <MudIcon Icon="@Icons.Material.Filled.Clear" Class="mr-2" />
                    <MudText>Clear</MudText>
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public AdvancedSearchRequest Model { get; set; } = new();
    [Parameter] public List<CountyInfo>? Counties { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    private async Task HandleSubmit()
    {
        // Manual validation for query name
        if (string.IsNullOrWhiteSpace(Model.QueryName))
        {
            Logger.LogWarning("Search attempted with empty query name");
            return;
        }

        // Always include match details
        Model.IncludeMatchDetails = true;

        Logger.LogInformation("Search form submitted for: {QueryName}", Model.QueryName);
        await OnSubmit.InvokeAsync();
    }

    private async Task ClearForm()
    {
        Logger.LogInformation("Clearing search form");
        Model.QueryName = string.Empty;
        Model.MaxResults = 50;
        Model.MinSimilarityThreshold = 50;
        Model.CountyId = null;
        Model.RecordType = null;
        Model.IncludeTrigramSimilarity = true;
        Model.ExpandNicknames = true;
        Model.IncludeMatchDetails = true;  // Always true
        
        await OnClear.InvokeAsync();
        StateHasChanged();
    }

    private async Task<IEnumerable<string>> SearchNames(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            return Array.Empty<string>();
        }

        try
        {
            var suggestions = await SearchApi.GetNameSuggestionsAsync(value, 10, cancellationToken);
            return suggestions;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching name suggestions for: {Prefix}", value);
            return Array.Empty<string>();
        }
    }
}
