@using MudBlazor
@using PhoneticAnalyzers.WebUI.Models

@if (Response?.Results is null || !Response.Results.Any())
{
    <MudAlert Severity="Severity.Info">No results.</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6">Search Results (@Response.TotalMatches)</MudText>

        @if (!ShowCategoryView)
        {
            <MudStack Spacing="2" Class="mt-3">
                @foreach (var r in Response.Results.Take(50))
                {
                    <MudPaper Class="pa-2" Elevation="0" Style="@($"border-left:4px solid {GetScoreBorderColor(r.SimilarityScore)}")">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body1">@r.FullName</MudText>
                            <MudChip T="string" Color="@GetScoreColor(r.SimilarityScore)" Variant="Variant.Filled">@r.SimilarityScore.ToString("P0")</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@r.MatchType</MudText>
                    </MudPaper>
                }
            </MudStack>
        }
        else
        {
            @if (Response.Results.Any(r => string.Equals(r.MatchType, "Exact", StringComparison.OrdinalIgnoreCase)))
            {
                var topExact = Response.Results.Where(r => string.Equals(r.MatchType, "Exact", StringComparison.OrdinalIgnoreCase))
                                               .OrderByDescending(r => r.SimilarityScore)
                                               .First();
                <MudPaper Class="pa-3 mt-3" Elevation="1" Style="@($"border-left:6px solid {GetScoreBorderColor(topExact.SimilarityScore)}")">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">@topExact.FullName</MudText>
                        <MudChip T="string" Color="@GetScoreColor(topExact.SimilarityScore)" Variant="Variant.Filled">@topExact.SimilarityScore.ToString("P0")</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Exact Match</MudText>
                </MudPaper>
            }

            <MudGrid Class="mt-3">
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Nickname</MudText>
                    @if (!Response.Results.Any(r => string.Equals(r.MatchType, "NicknameExpansion", StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
                    }
                    else
                    {
                        @foreach (var r in Response.Results.Where(r => string.Equals(r.MatchType, "NicknameExpansion", StringComparison.OrdinalIgnoreCase)).OrderByDescending(r => r.SimilarityScore).Take(5))
                        {
                            <MudPaper Class="pa-2 mb-1" Elevation="0" Style="@($"border-left:3px solid {GetScoreBorderColor(r.SimilarityScore)}")">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@r.FullName</MudText>
                                    <MudChip T="string" Color="@GetScoreColor(r.SimilarityScore)" Variant="Variant.Filled">@r.SimilarityScore.ToString("P0")</MudChip>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Fuzzy</MudText>
                    @if (!Response.Results.Any(r => string.Equals(r.MatchType, "TrigramSimilarity", StringComparison.OrdinalIgnoreCase)))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
                    }
                    else
                    {
                        @foreach (var r in Response.Results.Where(r => string.Equals(r.MatchType, "TrigramSimilarity", StringComparison.OrdinalIgnoreCase)).OrderByDescending(r => r.SimilarityScore).Take(5))
                        {
                            <MudPaper Class="pa-2 mb-1" Elevation="0" Style="@($"border-left:3px solid {GetScoreBorderColor(r.SimilarityScore)}")">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@r.FullName</MudText>
                                    <MudChip T="string" Color="@GetScoreColor(r.SimilarityScore)" Variant="Variant.Filled">@r.SimilarityScore.ToString("P0")</MudChip>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Phonetic</MudText>
                    @if (!Response.Results.Any(r => IsPhonetic(r.MatchType)))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
                    }
                    else
                    {
                        @foreach (var r in Response.Results.Where(r => IsPhonetic(r.MatchType)).OrderByDescending(r => r.SimilarityScore).Take(5))
                        {
                            <MudPaper Class="pa-2 mb-1" Elevation="0" Style="@($"border-left:3px solid {GetScoreBorderColor(r.SimilarityScore)}")">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@r.FullName</MudText>
                                    <MudChip T="string" Color="@GetScoreColor(r.SimilarityScore)" Variant="Variant.Filled">@r.SimilarityScore.ToString("P0")</MudChip>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Other</MudText>
                    @if (!Response.Results.Any(r => !string.Equals(r.MatchType, "Exact", StringComparison.OrdinalIgnoreCase)
                                                    && !string.Equals(r.MatchType, "NicknameExpansion", StringComparison.OrdinalIgnoreCase)
                                                    && !string.Equals(r.MatchType, "TrigramSimilarity", StringComparison.OrdinalIgnoreCase)
                                                    && !IsPhonetic(r.MatchType)))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">None</MudText>
                    }
                    else
                    {
                        @foreach (var r in Response.Results.Where(r => !string.Equals(r.MatchType, "Exact", StringComparison.OrdinalIgnoreCase)
                                                                       && !string.Equals(r.MatchType, "NicknameExpansion", StringComparison.OrdinalIgnoreCase)
                                                                       && !string.Equals(r.MatchType, "TrigramSimilarity", StringComparison.OrdinalIgnoreCase)
                                                                       && !IsPhonetic(r.MatchType))
                                                       .OrderByDescending(r => r.SimilarityScore).Take(5))
                        {
                            <MudPaper Class="pa-2 mb-1" Elevation="0" Style="@($"border-left:3px solid {GetScoreBorderColor(r.SimilarityScore)}")">
                                <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption">@r.FullName</MudText>
                                    <MudChip T="string" Color="@GetScoreColor(r.SimilarityScore)" Variant="Variant.Filled">@r.SimilarityScore.ToString("P0")</MudChip>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudItem>
            </MudGrid>
        }
    </MudPaper>
}

@code {
    [Parameter] public AdvancedSearchResponse? Response { get; set; }
    [Parameter] public bool ShowCategoryView { get; set; }

    private Color GetScoreColor(double score) => score switch
    {
        >= 0.95 => Color.Success,
        >= 0.8 => Color.Info,
        >= 0.5 => Color.Warning,
        _ => Color.Error
    };

    private string GetScoreBorderColor(double score) => score switch
    {
        >= 0.95 => "#10b981",
        >= 0.8 => "#3b82f6",
        >= 0.5 => "#f59e0b",
        _ => "#ef4444"
    };

    private static bool IsPhonetic(string? matchType)
    {
        if (string.IsNullOrWhiteSpace(matchType)) return false;
        return matchType.Equals("DoubleMetaphone", StringComparison.OrdinalIgnoreCase)
            || matchType.Equals("Metaphone", StringComparison.OrdinalIgnoreCase)
            || matchType.Equals("Soundex", StringComparison.OrdinalIgnoreCase)
            || matchType.Equals("PrimaryDoubleMetaphone", StringComparison.OrdinalIgnoreCase)
            || matchType.Equals("AlternateDoubleMetaphone", StringComparison.OrdinalIgnoreCase)
            || matchType.Equals("BeiderMorse", StringComparison.OrdinalIgnoreCase);
    }
}




