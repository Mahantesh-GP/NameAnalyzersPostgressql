@page "/search"
@inject ISearchApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Search> Logger
@inject IConfiguration Config

<PageTitle>Advanced Name Search - Phonetic Analyzers</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Advanced Name Search
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                   Color="Color.Primary" 
                   OnClick="@(() => _showHelpDialog = true)"
                   Title="Search Help Guide" />
</MudStack>

<SearchForm Model="_searchRequest" 
            Counties="_counties" 
            IsLoading="_isLoading"
            ShowCategoryView="_categoryView"
            OnSubmit="PerformSearch"
            OnClear="ClearSearch" />

<MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
    <MudSwitch T="bool" @bind-Value="_categoryView" Color="Color.Primary" />
    <MudText Typo="Typo.body2">Group by strategy (4 columns view)</MudText>
</MudStack>

@if (_isLoading && (_searchResponse == null || !_searchResponse.Results.Any()))
{
    <MudPaper Class="pa-6 mt-4 text-center" Elevation="2">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Color="Color.Primary">Searching...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Analyzing names across multiple strategies
            </MudText>
        </MudStack>
    </MudPaper>
}

<SearchResults Response="_filteredResponse" ShowCategoryView="_categoryView" />

<MudDialog @bind-Visible="_showHelpDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2" />
            Search Help Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Introduction -->
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Welcome!</strong> This tool helps you find names even if they're spelled differently, 
                    use nicknames, or have typos. The system scores each match to show how close it is to your search.
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">🔍 Quick Examples</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2">
                    <strong>What you can search:</strong><br/>
                    • <code>John Smith</code> → finds exact matches and typos like "Jon Smith"<br/>
                    • <code>Bill</code> → also finds William, Billy (nicknames)<br/>
                    • <code>Smith</code> → finds Smyth, Smythe (sounds similar)<br/>
                    • <code>Katherine</code> → finds Catherine, Kathryn (different spellings)
                </MudText>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">⚙️ Search Controls</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2"><strong>View Toggle</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        • <strong>List View</strong> (default): Shows all results in order, highest scores first<br/>
                        • <strong>Grouped View</strong>: Organizes results into 4 columns by match type
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2"><strong>Min Similarity (%)</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Sets the minimum match quality. Lower = more results; Higher = only close matches.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • <strong>30%</strong> (Default): Shows all types including phonetic matches (sounds-like)<br/>
                        • <strong>50%</strong>: Only good fuzzy matches and better<br/>
                        • <strong>85%</strong>: Very strict - exact matches and nicknames only
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2"><strong>Max Results</strong> (List view only)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        How many results to show (1-200). Grouped view always shows top 5 per strategy.
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">📊 Match Score Guide</MudText>

            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    Each result shows a <strong>score</strong> (%) that tells you how close the match is. 
                    Higher scores = better matches. Green is best, red is weakest.
                </MudText>
            </MudAlert>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2"><strong>95-100% (Green)</strong> - Exact or Nearly Perfect</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Your search matches the name exactly, or with just minor differences.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • Search "John Smith" → finds "John Smith" (100%)<br/>
                        • Search "ABC Solutions" → finds "ABC Solutions LLC" (95%)<br/>
                        • Search "Bill" → finds "William Anderson" (92% nickname match)
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2"><strong>80-94% (Blue)</strong> - Very Close Match</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        All your words match, but the name might have extra words or small typos.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • Search "John Smith" → finds "John Patrick Smith" (85%)<br/>
                        • Search "John Smyth" → finds "John Smith" (82% - typo fixed)<br/>
                        • Search "Micheal" → finds "Michael Brown" (80%)
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.BlurOn" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2"><strong>50-79% (Orange)</strong> - Partial or Fuzzy Match</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Some words match or names are similar but not exact.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • Search "Robert" → finds "Robertson" (65%)<br/>
                        • Search "Smith" → finds "Smythe & Associates" (60%)<br/>
                        • Helps find variations you might have missed
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Color="Color.Error" />
                        <MudText Typo="Typo.subtitle2"><strong>30-59% (Red)</strong> - Sounds Similar</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Names that sound alike but spelled very differently (phonetic matching).
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • Search "Stephen" → finds "Steven" (59%)<br/>
                        • Search "Katherine" → finds "Catherine" (56%)<br/>
                        • Search "Sean" → finds "Shawn" (53%)<br/>
                        • Useful for alternate spellings of the same sound
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudAlert Severity="Severity.Success" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>💡 Quick Tips:</strong><br/>
                    • Each person appears only <strong>once</strong> with their <strong>best score</strong><br/>
                    • Set Min Similarity to 85%+ to see only exact matches and nicknames<br/>
                    • Set Min Similarity to 30% to include all phonetic matches (sounds-like)<br/>
                    • Nicknames (Bill→William) work automatically<br/>
                    • Business names ignore legal suffixes (LLC, INC, etc.)
                </MudText>
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showHelpDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AdvancedSearchRequest _searchRequest = new()
    {
        MaxResults = 50,
        MinSimilarityThreshold = 30,
        IncludeTrigramSimilarity = false,
        ExpandNicknames = true,
        IncludePhonetic = false,
        IncludeMatchDetails = true
    };

    private List<CountyInfo> _counties = new();
    private AdvancedSearchResponse? _searchResponse;
    private AdvancedSearchResponse? _filteredResponse;
    private bool _isLoading;
    private bool _showHelpDialog;
    private bool _categoryView = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counties = await ApiClient.GetCountiesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load counties");
            Snackbar.Add("Failed to load counties list. Please refresh the page.", Severity.Warning);
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchRequest.QueryName))
        {
            Snackbar.Add("Please enter a name to search", Severity.Warning);
            return;
        }

        _isLoading = true;
        _searchResponse = null;

        try
        {
            // Convert percentage (0-100) to decimal (0.0-1.0) for API
            // Always fetch ALL strategies from backend (Exact + Nickname + Fuzzy + Phonetic)
            // Then filter on client side based on checkboxes
            var apiRequest = new AdvancedSearchRequest
            {
                QueryName = _searchRequest.QueryName,
                MaxResults = 200, // Fetch more to ensure we have enough after filtering
                MinSimilarityThreshold = _searchRequest.MinSimilarityThreshold / 100.0,
                CountyId = _searchRequest.CountyId,
                RecordType = _searchRequest.RecordType,
                IncludeTrigramSimilarity = true, // Always fetch all strategies
                ExpandNicknames = true,
                IncludeMatchDetails = _searchRequest.IncludeMatchDetails
            };

            _searchResponse = await ApiClient.AdvancedSearchAsync(apiRequest);
            
            if (_searchResponse != null)
            {
                // Filter and distribute results based on user's checkbox selection
                _filteredResponse = FilterAndDistributeResults(_searchResponse);
                Snackbar.Add($"Found {_filteredResponse.TotalMatches} matches in {_searchResponse.ExecutionTime:F0}ms", Severity.Success);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error during search");
            Snackbar.Add("Network error. Please check your connection and try again.", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during search");
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearSearch()
    {
        _searchResponse = null;
        _filteredResponse = null;
        Snackbar.Add("Search cleared", Severity.Info);
        StateHasChanged();
    }

    private AdvancedSearchResponse FilterAndDistributeResults(AdvancedSearchResponse response)
    {
        var maxResults = _searchRequest.MaxResults ?? 50;
        
        // Separate results by strategy type
        var exactMatches = response.Results.Where(r => 
            string.Equals(r.MatchType, "Exact", StringComparison.OrdinalIgnoreCase)).ToList();
        
        var nicknameMatches = response.Results.Where(r => 
            string.Equals(r.MatchType, "NicknameExpansion", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(r.MatchType, "Nickname", StringComparison.OrdinalIgnoreCase)).ToList();
        
        var fuzzyMatches = response.Results.Where(r => 
            string.Equals(r.MatchType, "TrigramSimilarity", StringComparison.OrdinalIgnoreCase)).ToList();
        
        var phoneticMatches = response.Results.Where(r => 
            string.Equals(r.MatchType, "DoubleMetaphone", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(r.MatchType, "Metaphone", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(r.MatchType, "Soundex", StringComparison.OrdinalIgnoreCase)).ToList();
        
        // Build result list based on enabled strategies
        var finalResults = new List<SearchResult>();
        
        // 1. Always include Exact matches (highest priority)
        finalResults.AddRange(exactMatches);
        
        // Count enabled strategies (not including Exact which is always on)
        var enabledStrategies = new List<string>();
        if (_searchRequest.ExpandNicknames == true) enabledStrategies.Add("Nickname");
        if (_searchRequest.IncludeTrigramSimilarity == true) enabledStrategies.Add("Fuzzy");
        if (_searchRequest.IncludePhonetic == true) enabledStrategies.Add("Phonetic");
        
        int remainingSlots = maxResults - finalResults.Count;
        
        if (enabledStrategies.Count > 0 && remainingSlots > 0)
        {
            // Distribute remaining slots proportionally among enabled strategies
            int slotsPerStrategy = remainingSlots / enabledStrategies.Count;
            int extraSlots = remainingSlots % enabledStrategies.Count;
            
            // 2. Add Nickname matches if enabled
            if (_searchRequest.ExpandNicknames == true)
            {
                int nicknameSlots = slotsPerStrategy + (extraSlots > 0 ? 1 : 0);
                extraSlots = Math.Max(0, extraSlots - 1);
                finalResults.AddRange(nicknameMatches.Take(nicknameSlots));
            }
            
            // 3. Add Fuzzy matches if enabled
            if (_searchRequest.IncludeTrigramSimilarity == true)
            {
                int fuzzySlots = slotsPerStrategy + (extraSlots > 0 ? 1 : 0);
                extraSlots = Math.Max(0, extraSlots - 1);
                finalResults.AddRange(fuzzyMatches.Take(fuzzySlots));
            }
            
            // 4. Add Phonetic matches if enabled
            if (_searchRequest.IncludePhonetic == true)
            {
                int phoneticSlots = slotsPerStrategy + (extraSlots > 0 ? 1 : 0);
                finalResults.AddRange(phoneticMatches.Take(phoneticSlots));
            }
        }
        
        // Take only maxResults (in case exact matches exceeded limit)
        finalResults = finalResults.Take(maxResults).ToList();
        
        return new AdvancedSearchResponse
        {
            Query = response.Query,
            Parameters = response.Parameters,
            TotalMatches = finalResults.Count,
            ExecutionTime = response.ExecutionTime,
            PhoneticCodes = response.PhoneticCodes,
            Results = finalResults,
            Warnings = response.Warnings
        };
    }


}
