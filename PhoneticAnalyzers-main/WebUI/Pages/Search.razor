@page "/search"
@inject ISearchApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Search> Logger

<PageTitle>Advanced Name Search - Phonetic Analyzers</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Advanced Name Search
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                   Color="Color.Primary" 
                   OnClick="@(() => _showHelpDialog = true)"
                   Title="Search Help Guide" />
</MudStack>

<SearchForm Model="_searchRequest" 
            Counties="_counties" 
            IsLoading="_isLoading" 
            OnSubmit="PerformSearch"
            OnClear="ClearSearch" />

<SearchResults Response="_searchResponse" />

<MudDialog @bind-Visible="_showHelpDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2" />
            Search Help Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Introduction -->
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Welcome to Phonetic Search!</strong> This tool finds names even with spelling variations, 
                    typos, or phonetic similarities. Use the options below to customize your search.
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">🔍 Quick Start Examples</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2">
                    <strong>Try these searches:</strong><br/>
                    • <code>John Smith</code> - Finds exact matches and similar sounding names<br/>
                    • <code>Robert</code> - Also finds Bob, Rob, Bobby (with Nicknames ON)<br/>
                    • <code>Smyth</code> - Finds Smith, Smythe, Smithe (phonetic matching)<br/>
                    • <code>Kathryn</code> - Finds Catherine, Katherine, Kathryn (sound-alike names)
                </MudText>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">⚙️ Search Parameters</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>Min Similarity</strong> (0% - 100%)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Controls how "fuzzy" the trigram matching is. Think of it as a tolerance slider.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            • <strong>30-40%</strong> (Default): Very permissive - catches most variations<br/>
                            • <strong>50-60%</strong>: Balanced - fewer false positives<br/>
                            • <strong>70%+</strong>: Strict - only very close matches<br/>
                            <br/>
                            <em>Example:</em> Searching "Jonathan" with 30% finds "Jonathon", "Johnathan", etc. 
                            With 70%, only very similar spellings match.
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="Color.Success" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Trigram</strong></MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Enables fuzzy string matching to catch typos and misspellings.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>When to use:</strong><br/>
                            ✅ Searching data with known typos or inconsistent spelling<br/>
                            ✅ Names from manual data entry (human error)<br/>
                            ✅ International names with multiple spellings<br/>
                            ❌ Turn OFF if you only want exact or phonetic matches<br/>
                            <br/>
                            <em>Example:</em> Finds "Micheal" when searching "Michael", or "Smth" → "Smith"
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Warning" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Nicknames</strong></MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Automatically expands your search to include common nickname variations.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>Nickname mappings include:</strong><br/>
                            • Robert → Rob, Bob, Bobby<br/>
                            • William → Will, Bill, Billy<br/>
                            • Elizabeth → Liz, Beth, Betty<br/>
                            • John → Johnny, Jack<br/>
                            • Michael → Mike, Mick<br/>
                            • And many more...<br/>
                            <br/>
                            <em>Example:</em> Search "Robert Smith" and also find "Bob Smith", "Bobby Smith" in results marked as "NicknameExpansion".
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Details</strong></MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Shows advanced phonetic analysis for each result. Great for understanding WHY names matched.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <strong>Includes:</strong><br/>
                            • Double Metaphone codes (phonetic fingerprint)<br/>
                            • Beider-Morse codes (multi-ethnic phonetics)<br/>
                            • Match explanation details<br/>
                            <br/>
                            💡 <em>Tip:</em> Click any result row to expand and see its phonetic breakdown.
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">📊 How Matching Works</MudText>

            <MudAlert Severity="Severity.Normal" Dense="true">
                <MudText Typo="Typo.body2">
                    Results are scored and ranked from highest to lowest. Each name gets ONE score based on 
                    the <strong>best matching method</strong> found. Higher scores = better matches.
                </MudText>
            </MudAlert>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>🥇 Exact</strong> (Score: 1.0)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Perfect match - your search exactly matches the person's full name (ignoring case).
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Example:</em> Search "john smith" → finds "John Smith" ✓
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Warning" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>🥈 NicknameExpansion</strong> (Score: 1.0)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Matches found using nickname variants (requires Nicknames checkbox ON). These are highly trusted matches.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Examples:</em><br/>
                            • Search "Robert" → finds "Bob Johnson", "Bobby Smith" ✓<br/>
                            • Search "William" → finds "Bill Jones", "Billy Williams" ✓<br/>
                            • Search "Elizabeth" → finds "Beth Parker", "Betty Miller" ✓<br/>
                            <br/>
                            💡 Results show which nickname was expanded: "bob → robert (nickname)"
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Info" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>🥉 DoubleMetaphone</strong> (Score: 0.9)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Advanced phonetic algorithm that matches names that sound alike in English.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Examples:</em><br/>
                            • "Stephen" ⟷ "Steven" (both sound like "STFN")<br/>
                            • "Philip" ⟷ "Phillip" (same pronunciation)<br/>
                            • "Caitlin" ⟷ "Katelyn" (sound similar)<br/>
                            • "Catherine" ⟷ "Katherine" ⟷ "Kathryn"
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Color="Color.Info" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>Metaphone</strong> (Score: 0.85)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Classic phonetic algorithm for English pronunciation matching.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Examples:</em><br/>
                            • "Sean" ⟷ "Shawn" (sound alike)<br/>
                            • "Geoffrey" ⟷ "Jeffrey" (similar pronunciation)<br/>
                            • "Carl" ⟷ "Karl" (same sound)
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Tertiary" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>Soundex</strong> (Score: 0.8)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Traditional phonetic coding system for English names, especially surnames.
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Examples:</em><br/>
                            • "Smith" ⟷ "Smythe" ⟷ "Smithe" (common surname variants)<br/>
                            • "Johnson" ⟷ "Jonson" (surname spelling variations)<br/>
                            • "Jackson" ⟷ "Jakson" (phonetically identical)
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.BlurOn" Color="Color.Default" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.subtitle2"><strong>TrigramSimilarity</strong> (Score: varies 0.3-0.8)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">
                            Fuzzy matching for typos and spelling variations. Score depends on how similar the strings are (controlled by Min Similarity setting).
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            <em>Examples:</em><br/>
                            • "Micheal" → finds "Michael" ✓ (common typo)<br/>
                            • "Smythe" → finds "Smith" ✓ (spelling variant)<br/>
                            • "Jonathon" → finds "Jonathan" ✓ (alternative spelling)<br/>
                            <br/>
                            💡 Each match shows the actual similarity percentage achieved
                        </MudText>
                    </div>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudAlert Severity="Severity.Success" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>💡 Pro Tips:</strong><br/>
                    • Results are sorted by <strong>score</strong> (highest first), then alphabetically<br/>
                    • Each person appears <strong>once</strong> with their <strong>best match type</strong> (highest score wins)<br/>
                    • Try lowering <strong>Min Similarity</strong> if you get too few trigram matches<br/>
                    • Enable <strong>Nicknames</strong> to catch informal name variations (Bob, Billy, Liz, etc.)<br/>
                    • Enable <strong>Details</strong> to see phonetic codes and match explanations<br/>
                    • <strong>Exact</strong> and <strong>NicknameExpansion</strong> matches (1.0 score) appear at the top<br/>
                    • <strong>Phonetic</strong> matches work great for sound-alike names across different spellings<br/>
                    • <strong>Trigram</strong> matches help find typos and close spelling variations
                </MudText>
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showHelpDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AdvancedSearchRequest _searchRequest = new()
    {
        MaxResults = 50,
        MinSimilarityThreshold = 30,
        IncludeTrigramSimilarity = true,
        ExpandNicknames = true,
        IncludeMatchDetails = true
    };

    private List<CountyInfo> _counties = new();
    private AdvancedSearchResponse? _searchResponse;
    private bool _isLoading;
    private bool _showHelpDialog;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counties = await ApiClient.GetCountiesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load counties");
            Snackbar.Add("Failed to load counties list. Please refresh the page.", Severity.Warning);
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchRequest.QueryName))
        {
            Snackbar.Add("Please enter a name to search", Severity.Warning);
            return;
        }

        _isLoading = true;
        _searchResponse = null;

        try
        {
            // Convert percentage (0-100) to decimal (0.0-1.0) for API
            var apiRequest = new AdvancedSearchRequest
            {
                QueryName = _searchRequest.QueryName,
                MaxResults = _searchRequest.MaxResults,
                MinSimilarityThreshold = _searchRequest.MinSimilarityThreshold / 100.0,
                CountyId = _searchRequest.CountyId,
                RecordType = _searchRequest.RecordType,
                IncludeTrigramSimilarity = _searchRequest.IncludeTrigramSimilarity,
                ExpandNicknames = _searchRequest.ExpandNicknames,
                IncludeMatchDetails = _searchRequest.IncludeMatchDetails
            };

            _searchResponse = await ApiClient.AdvancedSearchAsync(apiRequest);
            
            if (_searchResponse != null)
            {
                Snackbar.Add($"Found {_searchResponse.TotalMatches} matches in {_searchResponse.ExecutionTime:F0}ms", Severity.Success);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error during search");
            Snackbar.Add("Network error. Please check your connection and try again.", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during search");
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ClearSearch()
    {
        _searchResponse = null;
        Snackbar.Add("Search cleared", Severity.Info);
        return Task.CompletedTask;
    }
}
