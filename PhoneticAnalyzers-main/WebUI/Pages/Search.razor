@page "/search"
@inject ISearchApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Search> Logger
@inject IConfiguration Config

<PageTitle>Advanced Name Search - Phonetic Analyzers</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Advanced Name Search
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                   Color="Color.Primary" 
                   OnClick="@(() => _showHelpDialog = true)"
                   Title="Search Help Guide" />
</MudStack>

<SearchForm Model="_searchRequest" 
            Counties="_counties" 
            IsLoading="_isLoading" 
            OnSubmit="PerformSearch"
            OnClear="ClearSearch" />

@if (_isLoading && (_searchResponse == null || !_searchResponse.Results.Any()))
{
    <MudPaper Class="pa-6 mt-4 text-center" Elevation="2">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6" Color="Color.Primary">Searching...</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Analyzing names across multiple strategies
            </MudText>
        </MudStack>
    </MudPaper>
}

<SearchResults Response="_searchResponse" ShowCategoryView="_categoryView" />

<MudDialog @bind-Visible="_showHelpDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2" />
            Search Help Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Introduction -->
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Welcome to Advanced Name Search!</strong> This tool finds names with exact matches, 
                    typos, nickname variations, and phonetic similarities.
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">🔍 Quick Start Examples</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2">
                    <strong>Try these searches:</strong><br/>
                    • <code>John Smith</code> - Finds exact matches (100%) and partial matches<br/>
                    • <code>Robert</code> - Also finds Bob, Rob, Bobby (nickname matching)<br/>
                    • <code>Smyth</code> - Finds Smith, Smythe (phonetic and fuzzy matching)<br/>
                    • <code>Kathryn</code> - Finds Catherine, Katherine (sound-alike names)
                </MudText>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">⚙️ Search Settings</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2"><strong>Min Similarity (%)</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Controls how close fuzzy matches need to be.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • <strong>30%</strong> (Default): Finds most variations and typos<br/>
                        • <strong>50%</strong>: Balanced - fewer false matches<br/>
                        • <strong>70%</strong>: Very strict - only very close matches
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                <MudText Typo="Typo.body2">
                    <strong>ℹ️ Note:</strong> Fuzzy matching and nickname expansion are <strong>always enabled</strong> 
                    to provide comprehensive search results. The system automatically handles typos and common nicknames.
                </MudText>
            </MudAlert>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">📊 How Scoring Works</MudText>

            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    Each person appears <strong>once</strong> with their <strong>best match score</strong>. 
                    Results are ranked by match quality: exact matches first, followed by fuzzy and phonetic matches.
                </MudText>
            </MudAlert>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2"><strong>Exact Match</strong> (100%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Perfect match - your search exactly matches the full name or business core name.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "john smith" → "John Smith" (100%)<br/>
                        Example: "ABC Solutions" → "ABC Solutions LLC" (95% - business core match)
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2"><strong>All Tokens Exact</strong> (≤95%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        All your search words match exactly, but candidate may have extra words.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "john smith" → "John Patrick Smith" (~85%)<br/>
                        Explanation: "All your words match; plus extra words."
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.BlurOn" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2"><strong>High Coverage Fuzzy</strong> (75-89%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Most words match closely, handles typos and misspellings.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "john smyth" → "John Smith" (~85%)<br/>
                        Example: "micheal" → "Michael" (~82%)<br/>
                        Explanation: "Most words matched closely."
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Grain" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2"><strong>Partial Match</strong> (60-74%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Some words match, or longer similar names found.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "robert" → "Robertson" (~65% with superstring penalty)<br/>
                        Explanation: "Close match; includes a longer similar name."
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Color="Color.Secondary" />
                        <MudText Typo="Typo.subtitle2"><strong>Phonetic Match</strong> (≤59%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Names sound similar (uses Metaphone, Double Metaphone, or Soundex algorithms).
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Stephen" → "Steven"<br/>
                        Example: "Sean" → "Shawn"<br/>
                        Explanation: "Sounds like your search."
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudAlert Severity="Severity.Success" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>💡 Quick Tips:</strong><br/>
                    • Only <strong>full name exact</strong> matches score 100%<br/>
                    • Each person shows <strong>once</strong> with their <strong>best match</strong><br/>
                    • Lower <strong>Min Similarity %</strong> to find more typo variations<br/>
                    • Nicknames (Bob/Robert) and phonetic matches work automatically<br/>
                    • Business names ignore LLC/INC/etc. for matching
                </MudText>
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showHelpDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AdvancedSearchRequest _searchRequest = new()
    {
        MaxResults = 50,
        MinSimilarityThreshold = 30,
        IncludeTrigramSimilarity = true,
        ExpandNicknames = true,
        IncludeMatchDetails = true
    };

    private List<CountyInfo> _counties = new();
    private AdvancedSearchResponse? _searchResponse;
    private bool _isLoading;
    private bool _showHelpDialog;
    private bool _categoryView = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counties = await ApiClient.GetCountiesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load counties");
            Snackbar.Add("Failed to load counties list. Please refresh the page.", Severity.Warning);
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchRequest.QueryName))
        {
            Snackbar.Add("Please enter a name to search", Severity.Warning);
            return;
        }

        _isLoading = true;
        _searchResponse = null;

        try
        {
            // Convert percentage (0-100) to decimal (0.0-1.0) for API
            var apiRequest = new AdvancedSearchRequest
            {
                QueryName = _searchRequest.QueryName,
                MaxResults = _searchRequest.MaxResults,
                MinSimilarityThreshold = _searchRequest.MinSimilarityThreshold / 100.0,
                CountyId = _searchRequest.CountyId,
                RecordType = _searchRequest.RecordType,
                IncludeTrigramSimilarity = _searchRequest.IncludeTrigramSimilarity,
                ExpandNicknames = _searchRequest.ExpandNicknames,
                IncludeMatchDetails = _searchRequest.IncludeMatchDetails
            };

            _searchResponse = await ApiClient.AdvancedSearchAsync(apiRequest);
            if (_searchResponse != null)
            {
                Snackbar.Add($"Found {_searchResponse.TotalMatches} matches in {_searchResponse.ExecutionTime:F0}ms", Severity.Success);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error during search");
            Snackbar.Add("Network error. Please check your connection and try again.", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during search");
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ClearSearch()
    {
        _searchResponse = null;
        Snackbar.Add("Search cleared", Severity.Info);
        StateHasChanged();
    }


}
