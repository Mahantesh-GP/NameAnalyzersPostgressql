@page "/search"
@inject ISearchApiClient ApiClient
@inject ISnackbar Snackbar
@inject ILogger<Search> Logger

<PageTitle>Advanced Name Search - Phonetic Analyzers</PageTitle>

<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">
        <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-2" />
        Advanced Name Search
    </MudText>
    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" 
                   Color="Color.Primary" 
                   OnClick="@(() => _showHelpDialog = true)"
                   Title="Search Help Guide" />
</MudStack>

<SearchForm Model="_searchRequest" 
            Counties="_counties" 
            IsLoading="_isLoading" 
            OnSubmit="PerformSearch"
            OnClear="ClearSearch" />

<SearchResults Response="_searchResponse" />

<MudDialog @bind-Visible="_showHelpDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2" />
            Search Help Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <!-- Introduction -->
            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>Welcome to Phonetic Search!</strong> This tool finds names even with spelling variations, 
                    typos, or phonetic similarities. Use the options below to customize your search.
                </MudText>
            </MudAlert>

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">🔍 Quick Start Examples</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: #f5f5f5;">
                <MudText Typo="Typo.body2">
                    <strong>Try these searches:</strong><br/>
                    • <code>John Smith</code> - Finds exact matches and similar sounding names<br/>
                    • <code>Robert</code> - Also finds Bob, Rob, Bobby (with Nicknames ON)<br/>
                    • <code>Smyth</code> - Finds Smith, Smythe, Smithe (phonetic matching)<br/>
                    • <code>Kathryn</code> - Finds Catherine, Katherine, Kathryn (sound-alike names)
                </MudText>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">⚙️ Settings Explained</MudText>
            
            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2"><strong>Min Similarity (%)</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Controls how close names need to be for Trigram matching.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        • <strong>30%</strong> (Default): Finds most variations<br/>
                        • <strong>50%</strong>: Balanced - fewer false matches<br/>
                        • <strong>70%</strong>: Very strict - only close matches
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CheckBox" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Trigram</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Finds typos and misspellings (like "Micheal" → "Michael").
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        ✅ Turn ON for data with typos<br/>
                        ❌ Turn OFF for exact matches only
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Nicknames</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Finds nickname variations automatically.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Examples: Robert → Bob, Bobby | William → Bill, Billy | Elizabeth → Liz, Beth
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2"><strong>☑️ Details</strong></MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Shows phonetic codes and match explanations for each result.
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudText Typo="Typo.subtitle1" Color="Color.Primary">📊 Match Types (Best Match Wins)</MudText>

            <MudAlert Severity="Severity.Info" Dense="true">
                <MudText Typo="Typo.body2">
                    Each person appears <strong>once</strong> with their <strong>highest score</strong>. 
                    Results are sorted from best to worst match.
                </MudText>
            </MudAlert>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Success" />
                        <MudText Typo="Typo.subtitle2"><strong>Exact</strong> (100%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Perfect match - your search exactly matches the full name.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "john smith" finds "John Smith"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Warning" />
                        <MudText Typo="Typo.subtitle2"><strong>NicknameExpansion</strong> (100%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Finds names using common nickname variants (requires Nicknames checkbox).
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Robert" finds "Bob Smith", "Bobby Jones"<br/>
                        Shows: "bob → robert (nickname)"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2"><strong>DoubleMetaphone</strong> (90%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Matches names that sound alike.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Stephen" finds "Steven", "Catherine" finds "Katherine"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Color="Color.Info" />
                        <MudText Typo="Typo.subtitle2"><strong>Metaphone</strong> (85%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Phonetic matching for similar pronunciation.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Sean" finds "Shawn", "Geoffrey" finds "Jeffrey"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Tertiary" />
                        <MudText Typo="Typo.subtitle2"><strong>Soundex</strong> (80%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Traditional surname matching.
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Smith" finds "Smythe", "Johnson" finds "Jonson"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.BlurOn" Color="Color.Default" />
                        <MudText Typo="Typo.subtitle2"><strong>TrigramSimilarity</strong> (30-80%)</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">
                        Catches typos and spelling mistakes (controlled by Min Similarity %).
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Example: "Micheal" finds "Michael", "Smythe" finds "Smith"<br/>
                        Shows exact % match: "Token 'DAVIS' matched 'DAVIS' (100%)"
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudDivider />

            <MudAlert Severity="Severity.Success" Dense="true">
                <MudText Typo="Typo.body2">
                    <strong>💡 Quick Tips:</strong><br/>
                    • Each person shows <strong>once</strong> with their <strong>best match</strong><br/>
                    • Lower <strong>Min Similarity %</strong> to find more typo matches<br/>
                    • Enable <strong>Nicknames</strong> to find Bob, Bill, Liz variations<br/>
                    • <strong>Exact</strong> matches (100%) always appear first
                </MudText>
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showHelpDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AdvancedSearchRequest _searchRequest = new()
    {
        MaxResults = 50,
        MinSimilarityThreshold = 30,
        IncludeTrigramSimilarity = true,
        ExpandNicknames = true,
        IncludeMatchDetails = true
    };

    private List<CountyInfo> _counties = new();
    private AdvancedSearchResponse? _searchResponse;
    private bool _isLoading;
    private bool _showHelpDialog;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counties = await ApiClient.GetCountiesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load counties");
            Snackbar.Add("Failed to load counties list. Please refresh the page.", Severity.Warning);
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchRequest.QueryName))
        {
            Snackbar.Add("Please enter a name to search", Severity.Warning);
            return;
        }

        _isLoading = true;
        _searchResponse = null;

        try
        {
            // Convert percentage (0-100) to decimal (0.0-1.0) for API
            var apiRequest = new AdvancedSearchRequest
            {
                QueryName = _searchRequest.QueryName,
                MaxResults = _searchRequest.MaxResults,
                MinSimilarityThreshold = _searchRequest.MinSimilarityThreshold / 100.0,
                CountyId = _searchRequest.CountyId,
                RecordType = _searchRequest.RecordType,
                IncludeTrigramSimilarity = _searchRequest.IncludeTrigramSimilarity,
                ExpandNicknames = _searchRequest.ExpandNicknames,
                IncludeMatchDetails = _searchRequest.IncludeMatchDetails
            };

            _searchResponse = await ApiClient.AdvancedSearchAsync(apiRequest);
            
            if (_searchResponse != null)
            {
                Snackbar.Add($"Found {_searchResponse.TotalMatches} matches in {_searchResponse.ExecutionTime:F0}ms", Severity.Success);
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "HTTP error during search");
            Snackbar.Add("Network error. Please check your connection and try again.", Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during search");
            Snackbar.Add($"Search failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task ClearSearch()
    {
        _searchResponse = null;
        Snackbar.Add("Search cleared", Severity.Info);
        return Task.CompletedTask;
    }
}
